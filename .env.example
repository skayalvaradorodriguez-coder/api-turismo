NODE_ENV=development
PORT=3000

# Base de datos (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_turismo
DB_USER=
DB_PASSWORD=

# Sesion
JWT_SECRET=
SESSION_MINUTES=45
COOKIE_SECURE=false

# CORS: URL del frontend
FRONTEND_URL=http://localhost:4200

# Google (Etapa 9)
GOOGLE_CLIENT_ID=

# Correo (Etapas 7 y 8)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Archivos originales (carpeta fuera de src, no se sube a git) y tamano maximo por archivo en MB
STORAGE_DIR=storage
MAX_UPLOAD_MB=100
